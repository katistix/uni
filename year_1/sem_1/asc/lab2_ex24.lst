     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  
     3                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     4                                  global start        
     5                                  
     6                                  ; declare external functions needed by our program
     7                                  extern exit               ; tell nasm that exit exists even if we won't be defining it
     8                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
     9                                  segment data use32 class=data
    10                                      ; ...
    11                                  
    12                                  
    13                                  ; 256/1
    14                                  segment code use32 class=code
    15                                      start:
    16 00000000 66B8FF00                        mov ax, 255    ; put 256 into AX
    17 00000004 66BA0000                        mov dx, 0      ; clear DX so dividend = 0x00000100
    18 00000008 66BB0100                        mov bx, 1      ; divisor = 1
    19 0000000C 66F7F3                          div bx         ; unsigned divide DX:AX by BX
    20                                  
    21                                      
    22                                          ; exit(0)
    23 0000000F 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    24 00000011 FF15[00000000]                  call    [exit]       ; call exit to terminate the program
