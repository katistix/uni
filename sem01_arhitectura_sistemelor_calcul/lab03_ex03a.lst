     1                                  ;a - byte, b - word, c - double word, d - qword - Interpretare fara semn
     2                                  ;(c+d)-(a+d)+b 
     3                                  
     4                                  
     5                                  bits 32
     6                                  
     7                                  global start
     8                                  
     9                                  
    10                                  extern exit              
    11                                  import exit msvcrt.dll    
    12                                  
    13                                  segment data use32 class=data
    14 00000000 12                          a db 0x12
    15 00000001 3412                        b dw 0x1234
    16 00000003 01000000                    c dd 0x1
    17 00000007 FFFFFFFF00000000            d dq 0x0000_0000_ffff_ffff
    18                                  
    19                                  segment code use32 class=code
    20                                      start:
    21 00000000 A1[07000000]                    mov eax, dword [d]
    22 00000005 8B15[0B000000]                  mov edx, dword [d+4]
    23 0000000B 50                              push eax
    24 0000000C 52                              push edx
    25                                          
    26 0000000D 59                              pop ecx
    27 0000000E 5B                              pop ebx
    28                                      
    29                                      
    30                                      
    31                                      
    32                                      
    33                                          ; a+d
    34 0000000F A1[07000000]                    mov eax, dword [d]
    35 00000014 8B15[0B000000]                  mov edx, dword [d+4]
    36                                          
    37 0000001A BB00000000                      mov ebx, 0
    38 0000001F 8A1D[00000000]                  mov bl, byte [a]
    39                                          
    40 00000025 01D8                            add eax, ebx
    41 00000027 83D200                          adc edx, 0 
    42                                          ;save for later
    43 0000002A 50                              push eax
    44 0000002B 52                              push edx
    45                                          
    46                                          
    47                                          ;c+d
    48 0000002C A1[07000000]                    mov eax, dword [d]
    49 00000031 8B15[0B000000]                  mov edx, dword [d+4]
    50                                          
    51 00000037 0305[03000000]                  add eax, [c]
    52 0000003D 83D200                          adc edx, 0 ; edx:eax = c+d
    53                                          
    54                                          ; (c+d)-(a+d)
    55 00000040 59                              pop ecx
    56 00000041 5B                              pop ebx ; ecx:ebx = (a+d)
    57                                          
    58 00000042 29D8                            sub eax, ebx
    59 00000044 19CA                            sbb edx, ecx
    60                                          
    61                                          
    62                                          ; +b
    63                                          ;; facem ecx:ebx = word[b]
    64 00000046 B900000000                      mov ecx, 0
    65 0000004B BB00000000                      mov ebx, 0
    66 00000050 668B1D[01000000]                mov bx, word [b]
    67                                          
    68 00000057 01D8                            add eax, ebx
    69 00000059 83D200                          adc edx, 0  
    70                                          
    71                                          
    72                                          ; exit(0)
    73 0000005C 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    74 0000005E FF15[00000000]                  call    [exit]       ; call exit to terminate the program
