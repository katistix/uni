     1                                  ; Scrieți un program în limbaj de asamblare care să rezolve expresia aritmetică, considerând domeniile de definiție ale variabilelor
     2                                  ; a - doubleword; b, d - byte; c - word; e - qword
     3                                  ; a + b / c - d * 2 - e
     4                                  
     5                                  bits 32
     6                                  
     7                                  global start 
     8                                  
     9                                  extern exit
    10                                  import exit msvcrt.dll
    11                                  
    12                                  ; data segment
    13                                  segment data use32 class=data
    14                                      ; a,b,c,d
    15 00000000 7D000000                    a dd 125
    16 00000004 02                          b db 2
    17 00000005 0F00                        c dw 15
    18 00000007 C8                          d db 200
    19 00000008 5000000000000000            e dq 80
    20                                      
    21                                      
    22                                      
    23                                  segment code use32 class=data
    24                                      ;
    25                                      start:
    26                                          ; b/c
    27 00000000 A0[04000000]                    mov al, [b]
    28 00000005 B400                            mov ah, 0
    29 00000007 66BA0000                        mov dx, 0
    30                                          ; acum, dx:ax = b
    31 0000000B 66F735[05000000]                div word [c] ; impartim doubleword-ul dx:ax la word-ul c
    32                                          ; acum, catul impartirii este in ax (restul este in dx, dar mergem mai departe doar cu catul)
    33                                          
    34                                          ; d*2
    35 00000012 6689C3                          mov bx, ax ; eliberam ax pentru inmultire, punem pe b/c in bx
    36 00000015 B002                            mov al, 2
    37 00000017 F625[07000000]                  mul byte [d] ; ax=d*2
    38                                          
    39                                          
    40                                          ; (b/c) - (d*2) === bx - ax
    41 0000001D 6629C3                          sub bx, ax ; bx = (b/c) - (d*2)
    42                                          
    43                                          ; a + b/c - d*2 === [a] + bx
    44                                          ; a - doubleword, deci trebuie sa convertim bx in doubleword => cx:bx
    45 00000020 66B90000                        mov cx, 0
    46                                          
    47                                          ; punem pe a in 2 registri de tip word: dx:ax = [a]
    48 00000024 66A1[00000000]                  mov ax, word [a]
    49 0000002A 668B15[02000000]                mov dx, word [a+2]
    50                                          
    51 00000031 6601D8                          add ax, bx
    52 00000034 6601CA                          add dx, cx ; dx:ax = a+ b/c + d*2
    53                                          
    54                                          ; dx:ax - [e]
    55                                          
    56                                          ; convertim dx:ax intr-un word folosind stiva
    57 00000037 6652                            push dx
    58 00000039 6650                            push ax
    59 0000003B 58                              pop eax
    60                                          ; transformam eax intr-un quad
    61 0000003C BA00000000                      mov edx, 0 ; edx:eax = a + b / c - d * 2
    62                                          ; efectuam -e
    63 00000041 2B05[08000000]                  sub eax, dword [e]
    64 00000047 1B15[0C000000]                  sbb edx, dword [e+4]
    65                                          
    66                                          ; exit(0)
    67 0000004D 6A00                            push 0
    68 0000004F FF15[00000000]                  call [exit]
    69                                         
